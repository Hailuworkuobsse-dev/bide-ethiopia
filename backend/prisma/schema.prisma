generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum AuctionType {
  ASCENDING
  DESCENDING
}

enum BidStatus {
  ACCEPTED
  OUTBID
  WINNING
  REJECTED
}

enum PaymentProvider {
  TELEBIRR
  CBE_BIRR
  MANUAL
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model User {
  id           String     @id @default(cuid()) @db.VarChar(30)
  fullName     String     @db.VarChar(120)
  email        String?    @unique @db.VarChar(191)
  phone        String     @unique @db.VarChar(20)
  passwordHash String     @db.VarChar(255)
  role         UserRole   @default(BUYER)
  status       UserStatus @default(PENDING_VERIFICATION)
  preferredLanguage String @default("am") @db.VarChar(8)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  listings     Auction[]  @relation("SellerListings")
  bids         Bid[]
  auditEvents  AuditEvent[]
  payments     Payment[]
  @@index([role, status])
}

model Auction {
  id             String        @id @default(cuid()) @db.VarChar(30)
  sellerId       String        @db.VarChar(30)
  title          String        @db.VarChar(180)
  description    String        @db.Text
  category       String        @db.VarChar(60)
  condition      String?       @db.VarChar(40)
  region         String        @db.VarChar(80)
  city           String        @db.VarChar(80)
  imageUrls      Json?
  type           AuctionType   @default(ASCENDING)
  status         AuctionStatus @default(SCHEDULED)
  currency       String        @default("ETB") @db.VarChar(3)
  startingPrice  Decimal       @db.Decimal(14, 2)
  currentPrice   Decimal       @db.Decimal(14, 2)
  minimumIncrement Decimal     @default(1.00) @db.Decimal(14, 2)
  reservePrice   Decimal?      @db.Decimal(14, 2)
  startsAt       DateTime
  endsAt         DateTime
  winnerId       String?       @db.VarChar(30)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  seller         User          @relation("SellerListings", fields: [sellerId], references: [id])
  bids           Bid[]
  payments       Payment[]
  @@index([status, category, region])
  @@index([startsAt, endsAt])
  @@index([sellerId, createdAt])
}

model Bid {
  id         String    @id @default(cuid()) @db.VarChar(30)
  auctionId  String    @db.VarChar(30)
  bidderId   String    @db.VarChar(30)
  amount     Decimal   @db.Decimal(14, 2)
  status     BidStatus @default(ACCEPTED)
  createdAt  DateTime  @default(now())
  auction    Auction   @relation(fields: [auctionId], references: [id])
  bidder     User      @relation(fields: [bidderId], references: [id])
  @@index([auctionId, amount])
  @@index([bidderId, createdAt])
}

model Payment {
  id                  String         @id @default(cuid()) @db.VarChar(30)
  userId              String         @db.VarChar(30)
  auctionId           String         @db.VarChar(30)
  provider            PaymentProvider
  status              PaymentStatus  @default(INITIATED)
  amount              Decimal        @db.Decimal(14, 2)
  currency            String         @default("ETB") @db.VarChar(3)
  providerReference   String?        @unique @db.VarChar(191)
  idempotencyKey      String         @unique @db.VarChar(191)
  providerPayload     Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id])
  auction             Auction        @relation(fields: [auctionId], references: [id])
  @@index([status, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid()) @db.VarChar(30)
  actorId     String?  @db.VarChar(30)
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.VarChar(30)
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
